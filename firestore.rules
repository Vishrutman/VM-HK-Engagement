rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      // Allow all visitors to view blessings on the Ashirvad wall
      allow read: if true;

      // Allow guests to submit an auspicious blessing with validation
      allow create: if request.resource.data.guestName is string
                    && request.resource.data.guestName.size() > 0
                    && request.resource.data.guestName.size() <= 120
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.timestamp is number;

      // Allow a "like" on a blessing: only the `likes` field may change,
      // and only by exactly +1. Everything else stays immutable.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && request.resource.data.likes is number
                    && request.resource.data.likes == resource.data.get('likes', 0) + 1;

      // Restrict public deletions
      allow delete: if false;
    }
  }
}
